      <column caption='ABC ' datatype='string' name='[Calculation_1403105167724544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1388948949356550] &gt;= 1000000 THEN &quot;A&quot;&#10;ELSEIF [Calculation_1388948949356550] &gt;= 100000 THEN &quot;B&quot;&#10;ELSE &quot;C&quot;&#10;END' />
