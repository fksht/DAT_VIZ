      <column caption='Pod minimom flag' datatype='string' name='[Calculation_1403105332154375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1388948949356550] &lt; [Minimum skladu] THEN &quot;Pod minimom&quot;&#10;ELSE &quot;OK&quot;&#10;END' />
